{
	"$schema": "./node_modules/markdownlint-cli2/schema/markdownlint-cli2-config-schema.json",
	"config": {
		"default": true,
		"MD010": false,
		"MD013": false
	},
	"gitignore": true,
	"globs": ["README.md", "docs/**/*.md", "sources/**/*.md", ".github/**/*.md"],
	"overrides": [
		{
			"filter": [".github/agents/**/*.md", "sources/**/*.md"],
			"config": {
				"MD041": false
			},
			"combine": "merge"
		}
	]
}
