{
	"name": "agents-skills",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.15.0",
		"npm": "11.12.1"
	},
	"scripts": {
		"build": "tsx src/build-skills.ts --write",
		"check": "npm run format && npm run lint:markdown && npm run typecheck && npm test && npm run check:customizations && npm run check:drift",
		"check:customizations": "tsx src/check-customizations.ts",
		"check:drift": "tsx src/build-skills.ts --check",
		"eval:memory": "tsx scripts/run-agent-evals.ts --dir $HOME/.memory/node-testing-notes/test",
		"eval:waza": "tsx scripts/run-waza.ts",
		"format": "biome check --write . && prettier --write README.md AGENTS.md 'skills/**/*.md' 'agents/**/*.md' 'docs/**/*.md' 'evals/**/*.md' 'sources/**/*.md'",
		"install:artifacts": "tsx scripts/install-artifacts.ts",
		"setup": "tsx scripts/install.ts",
		"install:omp": "tsx scripts/install-omp.ts",
		"install:pi": "tsx scripts/install-pi.ts",
		"uninstall:artifacts": "tsx scripts/uninstall-artifacts.ts",
		"uninstall:omp": "tsx scripts/uninstall-omp.ts",
		"uninstall:pi": "tsx scripts/uninstall-pi.ts",
		"register:memory": "node --experimental-strip-types skills/remember-that/scripts/register-memory.ts",
		"install:clients": "npm run install:artifacts --",
		"lint": "biome check .",
		"lint:markdown": "markdownlint-cli2",
		"prepare": "git config core.hooksPath .githooks",
		"test": "tsx --test test/*.test.ts",
		"test:toolkit": "bun test test/toolkit",
		"start:toolkit": "bun run src/server.ts",
		"typecheck:toolkit": "tsc --noEmit --project test/toolkit/tsconfig.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"csv-parse": "7.0.3",
		"yaml": "2.9.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "1.4.2",
		"@types/node": "24.13.3",
		"markdownlint-cli2": "0.23.2",
		"prettier": "^3.9.9",
		"tsx": "4.23.12",
		"typescript": "7.0.2"
	}
}
